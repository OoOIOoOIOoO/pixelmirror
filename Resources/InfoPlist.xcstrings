    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر PixelMirror على هاتفك في هذه الشبكة عند تشغيل تصحيح الأخطاء اللاسلكي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror findet dein Handy in diesem Netzwerk, wenn Debugging über WLAN an ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror encuentra tu teléfono en esta red cuando la depuración inalámbrica está activada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror trouve votre téléphone sur ce réseau quand le débogage sans fil est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror trova il telefono su questa rete quando il debug wireless è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイヤレス デバッグがオンのとき、PixelMirror はこのネットワーク上のスマホを見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무선 디버깅이 켜져 있으면 PixelMirror가 이 네트워크에서 휴대전화를 찾습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror vindt je telefoon op dit netwerk als draadloze foutopsporing aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror znajduje telefon w tej sieci, gdy debugowanie bezprzewodowe jest włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PixelMirror encontra seu telefone nesta rede quando a depuração por Wi‑Fi está ativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror находит телефон в этой сети, когда включена отладка по Wi‑Fi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kablosuz hata ayıklama açıkken PixelMirror telefonunuzu bu ağda bulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixelMirror tìm điện thoại của bạn trong mạng này khi Gỡ lỗi không dây đang bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开「无线调试」后，Pixel 镜像会在这个网络里自动找到你的手机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「無線偵錯」後，Pixel 鏡像會在這個網路中自動找到你的手機。"
          }
        }
      }
    }
  }
