    "Stop mirroring with the phone's screen off, and it locks, as if laid face down." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف النسخ وشاشة الهاتف مطفأة، فيُقفل كأنه مقلوب على وجهه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendest du die Spiegelung bei ausgeschaltetem Display, sperrt sich das Handy, als läge es mit dem Display nach unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si dejas de duplicar con la pantalla apagada, el teléfono se bloquea, como si lo dejaras boca abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez la recopie écran éteint, et le téléphone se verrouille, comme posé face contre la table."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompi il mirroring con lo schermo spento e il telefono si blocca, come se fosse a faccia in giù."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面オフのままミラーリングを終えると、伏せて置いたようにスマホがロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면이 꺼진 채로 미러링을 끝내면, 엎어 둔 것처럼 휴대전화가 잠깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop met spiegelen terwijl het scherm uit is, en de telefoon vergrendelt, alsof hij omgekeerd ligt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ dublowanie przy wyłączonym ekranie, a telefon się zablokuje, jakby leżał ekranem w dół."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare o espelhamento com a tela desligada e o telefone bloqueia, como se estivesse virado para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершите трансляцию с выключенным экраном, и телефон заблокируется, будто лежит экраном вниз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran kapalıyken yansıtmayı durdurun, telefon yüzüstü bırakılmış gibi kilitlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dừng phản chiếu khi màn hình điện thoại đang tắt, máy sẽ tự khóa như khi úp xuống bàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手机屏幕关闭时停止镜像，手机会锁上，就像把它扣在桌上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手機螢幕關閉時停止鏡像，手機會鎖定，就像把它扣在桌上。"
          }
        }
      }
    },
