    "Tap Allow, and tick Always allow from this computer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط «سماح» وحدِّد «السماح دائمًا من هذا الكمبيوتر»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Zulassen“ und wähle „Von diesem Computer immer zulassen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Permitir y marca Permitir siempre desde este ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Autoriser et cochez Toujours autoriser cet ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Consenti e seleziona Consenti sempre da questo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「許可」をタップし、「このパソコンからのアクセスを常に許可」にチェック。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용을 누르고 '이 컴퓨터에서 항상 허용'을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Toestaan en vink Altijd toestaan vanaf deze computer aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij Zezwól i zaznacz Zawsze zezwalaj z tego komputera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Permitir e marque Sempre permitir neste computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Разрешить» и отметьте «Всегда разрешать с этого компьютера»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin ver'e dokunun ve Bu bilgisayardan her zaman izin ver'i işaretleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn Cho phép và chọn Luôn cho phép từ máy tính này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点「允许」，并勾选「一律允许使用这台计算机进行调试」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點「允許」，並勾選「一律允許這部電腦」。"
          }
        }
      }
    },
    "Tap Pair device with pairing code, then enter the code here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط «إقران الجهاز باستخدام رمز الإقران»، ثم أدخل الرمز هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Gerät über Kopplungscode koppeln“ und gib den Code hier ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Vincular dispositivo con código de sincronización e introduce el código aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Associer l'appareil avec un code d'association, puis saisissez le code ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Accoppia dispositivo con codice di accoppiamento e inserisci il codice qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ペア設定コードによるデバイスのペア設定」をタップし、コードをここに入力。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'페어링 코드로 기기 페어링'을 탭하고 여기에 코드를 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Apparaat koppelen met koppelingscode en voer de code hier in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij Sparuj urządzenie za pomocą kodu parowania i wpisz kod tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Parear dispositivo com código de pareamento e digite o código aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Подключить устройство с помощью кода подключения» и введите код здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleme kodu ile cihaz eşle'ye dokunun ve kodu buraya girin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn Ghép nối thiết bị bằng mã ghép nối, rồi nhập mã vào đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点「使用配对码配对设备」，在这里输入配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點「使用配對碼配對裝置」，在這裡輸入配對碼。"
          }
        }
      }
    },
