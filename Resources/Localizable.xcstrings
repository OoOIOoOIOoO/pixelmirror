    "It can hide your phone. Turn it off to connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تُخفي هاتفك. أوقفها للاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kann dein Handy verbergen. Zum Verbinden ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede ocultar tu teléfono. Desactívala para conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il peut masquer votre téléphone. Désactivez‑le pour vous connecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può nascondere il telefono. Disattivala per connetterti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマホが見えなくなることがあります。オフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대전화가 보이지 않을 수 있습니다. 끄고 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kan je telefoon verbergen. Zet hem uit om te verbinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może ukrywać telefon. Wyłącz go, aby się połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela pode esconder o telefone. Desative para conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он может скрывать телефон. Выключите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuzu gizleyebilir. Bağlanmak için kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN có thể che điện thoại. Hãy tắt để kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能让手机无法被找到，关闭后再连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能讓手機無法被找到，關閉後再連線。"
          }
        }
      }
    },
