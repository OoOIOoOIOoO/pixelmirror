    "Click to place a key, then press it. Drag to move, Delete to remove." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر لوضع مفتاح ثم اضغطه. اسحب للنقل، واضغط حذف للإزالة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke, um eine Taste zu platzieren, und drücke sie. Ziehen bewegt, Löschen entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para colocar una tecla y púlsala. Arrastra para mover; Suprimir para eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez pour placer une touche, puis appuyez dessus. Faites glisser pour déplacer, Supprimer pour retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic per posizionare un tasto, poi premilo. Trascina per spostare, Elimina per rimuovere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックしてキーを置き、そのキーを押します。ドラッグで移動、delete で削除。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하여 키를 배치한 다음 해당 키를 누르십시오. 드래그하여 이동, Delete로 제거."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik om een toets te plaatsen en druk erop. Sleep om te verplaatsen, Delete om te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij, aby umieścić klawisz, i naciśnij go. Przeciągnij, aby przenieść; Delete usuwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique para posicionar uma tecla e pressione-a. Arraste para mover, Apagar para remover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щелкните, чтобы поставить клавишу, и нажмите ее. Перетащите для перемещения, Delete — удалить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuş yerleştirmek için tıklayın, sonra tuşa basın. Taşımak için sürükleyin, silmek için Sil’e basın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm để đặt phím rồi nhấn phím đó. Kéo để di chuyển, Delete để xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按以放置按键，然后按下该键。拖移可移动，按 Delete 可移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下以放置按鍵，然後按下該鍵。拖移可移動，按 Delete 可移除。"
          }
        }
      }
    },
