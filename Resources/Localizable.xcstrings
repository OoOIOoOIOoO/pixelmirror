    "In System Settings, allow PixelMirror under Camera Extensions, then choose Use as Webcam again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في إعدادات النظام، اسمح بـ PixelMirror ضمن ملحقات الكاميرا، ثم اختر «استخدام ككاميرا ويب» مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube PixelMirror in den Systemeinstellungen unter „Kameraerweiterungen“ und wähle dann erneut „Als Webcam verwenden“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes del Sistema, permite PixelMirror en Extensiones de cámara y vuelve a elegir «Usar como cámara web»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages Système, autorisez PixelMirror sous Extensions de caméra, puis choisissez à nouveau « Utiliser comme webcam »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Impostazioni di Sistema, consenti PixelMirror in Estensioni fotocamera, quindi scegli di nuovo “Usa come webcam”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定の「カメラ機能拡張」でPixelMirrorを許可してから、もう一度「Webカメラとして使用」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정의 카메라 확장 프로그램에서 PixelMirror를 허용한 다음 ‘웹캠으로 사용’을 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta PixelMirror toe bij ‘Camera-extensies’ in Systeeminstellingen en kies daarna opnieuw ‘Gebruiken als webcam’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Ustawieniach systemowych zezwól na PixelMirror w sekcji Rozszerzenia kamery, a następnie ponownie wybierz „Użyj jako kamery internetowej”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Ajustes do Sistema, permita o PixelMirror em Extensões de Câmera e escolha “Usar como webcam” novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Системных настройках разрешите PixelMirror в разделе «Расширения камеры», затем снова выберите «Использовать как веб‑камеру»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları’nda Kamera Uzantıları altında PixelMirror’a izin verin, sonra yeniden Web Kamerası Olarak Kullan’ı seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong Cài đặt hệ thống, cho phép PixelMirror trong Tiện ích mở rộng camera, rồi chọn lại Dùng làm webcam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
