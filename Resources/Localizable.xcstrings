    "Wireless debugging turns off after a restart or a Wi-Fi change. Turn it on again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف تصحيح الأخطاء اللاسلكي بعد إعادة التشغيل أو تغيير شبكة Wi‑Fi. شغّله من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugging über WLAN schaltet sich nach einem Neustart oder WLAN‑Wechsel aus. Schalte es wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La depuración inalámbrica se desactiva al reiniciar o cambiar de Wi‑Fi. Vuelve a activarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le débogage sans fil s'arrête après un redémarrage ou un changement de Wi‑Fi. Réactivez‑le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il debug wireless si disattiva dopo un riavvio o un cambio di Wi‑Fi. Riattivalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイヤレス デバッグは再起動や Wi‑Fi の切り替えでオフになります。もう一度オンに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무선 디버깅은 재시작하거나 Wi‑Fi를 바꾸면 꺼집니다. 다시 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draadloze foutopsporing gaat uit na een herstart of ander wifi. Zet het weer aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugowanie bezprzewodowe wyłącza się po restarcie lub zmianie Wi‑Fi. Włącz je ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A depuração por Wi‑Fi desliga ao reiniciar ou trocar de Wi‑Fi. Ative de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отладка по Wi‑Fi выключается после перезагрузки или смены сети. Включите её снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kablosuz hata ayıklama yeniden başlatınca veya Wi‑Fi değişince kapanır. Tekrar açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gỡ lỗi không dây tắt sau khi khởi động lại hoặc đổi Wi‑Fi. Hãy bật lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机重启或换 Wi‑Fi 后，「无线调试」会自动关闭，请重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機重新開機或換 Wi‑Fi 後，「無線偵錯」會自動關閉，請重新開啟。"
          }
        }
      }
    },
