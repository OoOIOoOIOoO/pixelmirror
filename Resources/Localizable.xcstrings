    "When the phone is locked, Computer Mode shows its lock screen first, then opens the desktop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يكون الهاتف مقفلًا، يعرض وضع الكمبيوتر شاشة القفل أولًا ثم يفتح سطح المكتب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist das Handy gesperrt, zeigt der Computermodus zuerst den Sperrbildschirm und öffnet dann den Schreibtisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el teléfono está bloqueado, el modo ordenador muestra primero la pantalla de bloqueo y luego abre el escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le téléphone est verrouillé, le mode ordinateur affiche d’abord l’écran de verrouillage, puis ouvre le bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il telefono è bloccato, la modalità computer mostra prima la schermata di blocco, poi apre la scrivania."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマホがロック中なら、コンピュータモードはまずロック画面を表示し、解除後にデスクトップを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대전화가 잠겨 있으면 컴퓨터 모드가 먼저 잠금 화면을 보여 주고, 해제하면 데스크톱을 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is de telefoon vergrendeld, dan toont de computermodus eerst het vergrendelscherm en opent daarna het bureaublad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy telefon jest zablokowany, tryb komputera najpierw pokazuje ekran blokady, a potem otwiera pulpit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o telefone estiver bloqueado, o modo computador mostra primeiro a tela de bloqueio e depois abre a área de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если телефон заблокирован, режим компьютера сначала показывает экран блокировки, а затем открывает рабочий стол."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon kilitliyse Bilgisayar Modu önce kilit ekranını gösterir, ardından masaüstünü açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi điện thoại bị khóa, Chế độ máy tính sẽ hiện màn hình khóa trước rồi mới mở màn hình nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机锁着时，电脑模式会先显示锁屏，解锁后再打开桌面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機鎖著時，電腦模式會先顯示鎖定畫面，解鎖後再打開桌面。"
          }
        }
      }
    },
