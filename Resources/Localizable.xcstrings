    "Your router may keep devices apart. Try another Wi-Fi, or a cable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يعزل الموجّه الأجهزة عن بعضها. جرّب شبكة Wi‑Fi أخرى أو كابلًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Router trennt eventuell Geräte. Anderes WLAN oder Kabel versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El router puede aislar los dispositivos. Prueba otra Wi‑Fi o un cable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le routeur isole peut‑être les appareils. Essayez un autre Wi‑Fi ou un câble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il router potrebbe isolare i dispositivi. Prova un'altra Wi‑Fi o un cavo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルーターが端末同士を分離している可能性があります。別の Wi‑Fi かケーブルで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유기가 기기를 분리할 수 있습니다. 다른 Wi‑Fi나 케이블을 쓰세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je router houdt apparaten mogelijk gescheiden. Probeer ander wifi of een kabel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router może izolować urządzenia. Użyj innej sieci Wi‑Fi lub kabla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O roteador pode isolar os aparelhos. Tente outro Wi‑Fi ou um cabo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Роутер может изолировать устройства. Попробуйте другую сеть или кабель."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönlendirici cihazları ayırıyor olabilir. Başka Wi‑Fi veya kablo deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ định tuyến có thể cách ly thiết bị. Thử Wi‑Fi khác hoặc cáp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器可能隔离了设备。换个 Wi‑Fi，或插数据线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器可能隔離了裝置。換個 Wi‑Fi，或接上傳輸線。"
          }
        }
      }
    }
